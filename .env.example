# ============================================================
# Copie para:
#   web/.env.local  -> variáveis VITE_*
#   api/.env        -> variáveis do servidor
# NUNCA commite valores reais. Use chaves NOVAS (as do chat vazaram).
# ============================================================

# --- Frontend (Vite) → web/.env.local ---
# Sem URL/anon key válidos, o front roda em MODO DEMO (localStorage/mock).
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SEU_PUBLISHABLE_KEY_AQUI
# Habilita chamadas à API FastAPI para emissão/download.
VITE_API_URL=http://localhost:8000
# true mantém o modo demo mesmo com credenciais preenchidas
VITE_FORCE_MOCK=true

# --- Backend (FastAPI) → api/.env ---
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SEU_SERVICE_ROLE_KEY_AQUI
DATABASE_URL=postgresql://postgres:SENHA@db.SEU_PROJETO.supabase.co:5432/postgres
CORS_ORIGINS=http://localhost:5173,https://SEU_SITE.vercel.app
STORAGE_BUCKET=documentos

# Chave mestra para criptografar o certificado A1 no cofre (KMS/Vault em produção)
# Use UMA das duas opções. Em produção, prefira o arquivo montado pelo KMS/Vault.
CERT_ENCRYPTION_KEY=TROQUE_POR_CHAVE_GERENCIADA
# CERT_ENCRYPTION_KEY_FILE=/run/secrets/cert_key

# Webhook opcional de alerta de falha de job (Slack/Teams/etc.)
ALERT_WEBHOOK_URL=

# true = endpoints da API respondem 501 (sem Supabase). Mude para false ao configurar.
MOCK_MODE=true

# --- NFS-e Nacional (ADN) — desligado até haver certificado credenciado ---
# Só habilite depois de cadastrar o A1 da empresa e credenciar no ADN/gov.br.
NFSE_ENABLED=false
# homologacao = adn.producaorestrita.nfse.gov.br | producao = adn.nfse.gov.br
NFSE_ADN_ENV=homologacao
